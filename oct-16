class Solution {
    public boolean canPlaceFlowers(int[] f, int n) {
        int count=0;
        int z=f.length;
        if(z==0) return false;
        if(z==1 && f[z-1]==0){
            count++;
            f[z-1]=1;
        }
        if(f[0]==0 && f[1]==0){
            count++;
            f[0]=1;
        }
        if(f[z-1]==0 && f[z-2]==0){
            count++;
            f[z-1]=1;
        }
        for(int i=1;i<z-1;i++){
            if(f[i]!=1){
            if(f[i-1]==0 && f[i+1]==0){
                count++;
                f[i]=1;
            }
            }
        }
        if(count>=n){
            return true;
        }
        return false;
    }
}
