class Solution {
    public int minMoves(int[] nums) {
        int max=0,sum=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]>max){
                max=nums[i];
            }
        }
        for(int i=0;i<nums.length;i++){
            if(nums[i]!=max){
                sum+=max-nums[i];
            }
        }
        return sum;
    }
}
